+namespace {
+constexpr int kBatteryWidgetWidth = 48;
+constexpr int kBatteryWidgetHeight = 22;
+constexpr int kBatteryBodyWidth = 43;
+constexpr int kBatteryBodyHeight = 22;
+constexpr int kBatteryFillHeight = 16;
+constexpr int kBatteryCapWidth = 4;
+constexpr int kBatteryCapHeight = 9;
+
+void CreateBatteryStatusWidget(lv_obj_t* parent, LvglTheme* lvgl_theme, lv_obj_t*& container,
+                               lv_obj_t*& body, lv_obj_t*& fill, lv_obj_t*& cap,
+                               lv_obj_t*& percent_label) {
+    container = lv_obj_create(parent);
+    lv_obj_set_size(container, kBatteryWidgetWidth, kBatteryWidgetHeight);
+    lv_obj_set_style_bg_opa(container, LV_OPA_TRANSP, 0);
+    lv_obj_set_style_border_width(container, 0, 0);
+    lv_obj_set_style_pad_all(container, 0, 0);
+    lv_obj_set_scrollbar_mode(container, LV_SCROLLBAR_MODE_OFF);
+    lv_obj_clear_flag(container, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_margin_left(container, lvgl_theme->spacing(2), 0);
+
+    body = lv_obj_create(container);
+    lv_obj_set_size(body, kBatteryBodyWidth, kBatteryBodyHeight);
+    lv_obj_align(body, LV_ALIGN_LEFT_MID, 0, 0);
+    lv_obj_set_style_bg_opa(body, LV_OPA_TRANSP, 0);
+    lv_obj_set_style_border_width(body, 2, 0);
+    lv_obj_set_style_border_color(body, lvgl_theme->text_color(), 0);
+    lv_obj_set_style_radius(body, 3, 0);
+    lv_obj_set_style_pad_all(body, 0, 0);
+    lv_obj_set_scrollbar_mode(body, LV_SCROLLBAR_MODE_OFF);
+    lv_obj_clear_flag(body, LV_OBJ_FLAG_SCROLLABLE);
+
+    fill = lv_obj_create(body);
+    lv_obj_set_size(fill, 0, kBatteryFillHeight);
+    lv_obj_align(fill, LV_ALIGN_LEFT_MID, 3, 0);
+    lv_obj_set_style_bg_color(fill, lv_color_hex(0x2F80ED), 0);
+    lv_obj_set_style_bg_opa(fill, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(fill, 0, 0);
+    lv_obj_set_style_radius(fill, 2, 0);
+    lv_obj_set_style_pad_all(fill, 0, 0);
+    lv_obj_clear_flag(fill, LV_OBJ_FLAG_SCROLLABLE);
+
+    percent_label = lv_label_create(body);
+    lv_label_set_text(percent_label, "");
+    lv_obj_set_width(percent_label, kBatteryBodyWidth);
+    lv_obj_set_style_text_align(percent_label, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(percent_label, &lv_font_montserrat_14, 0);
+    lv_obj_set_style_text_color(percent_label, lv_color_white(), 0);
+    lv_obj_set_style_text_outline_stroke_color(percent_label, lv_color_black(), 0);
+    lv_obj_set_style_text_outline_stroke_width(percent_label, 1, 0);
+    lv_obj_set_style_text_outline_stroke_opa(percent_label, LV_OPA_COVER, 0);
+    lv_obj_center(percent_label);
+
+    cap = lv_obj_create(container);
+    lv_obj_set_size(cap, kBatteryCapWidth, kBatteryCapHeight);
+    lv_obj_align(cap, LV_ALIGN_RIGHT_MID, 0, 0);
+    lv_obj_set_style_bg_color(cap, lvgl_theme->text_color(), 0);
+    lv_obj_set_style_bg_opa(cap, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(cap, 0, 0);
+    lv_obj_set_style_radius(cap, 1, 0);
+    lv_obj_set_style_pad_all(cap, 0, 0);
+    lv_obj_clear_flag(cap, LV_OBJ_FLAG_SCROLLABLE);
+}
+}
